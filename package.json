{
  "name": "readoutto-me",
  "version": "0.0.1",
  "description": "Web application to read text out online",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "deno run --allow-net --allow-read=public --allow-read=src/web --allow-read=data --allow-write=data --allow-env src/server.ts",
    "dev": "deno run --watch --allow-net --allow-read=public --allow-read=src/web  --allow-read=data --allow-write=data --allow-env src/server.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "gabriel",
  "license": "WTFPL",
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "hono": "^4.12.18",
    "msedge-tts": "^2.0.5"
  }
}
