{
  "name": "readoutto-me",
  "version": "0.0.1",
  "description": "Web application to read text out online",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prepare": "simple-git-hooks",
    "start": "deno run --no-prompt --allow-net --allow-read=dist --allow-read=data --allow-write=data --allow-env src/server.ts",
    "dev": "concurrently \"deno task dev:client\" \"deno task dev:server\"",
    "dev:server": "deno run --watch --allow-net --allow-read=dist --allow-read=data --allow-write=data --allow-env src/server.ts",
    "dev:client": "vite build --watch",
    "build": "vite build",
    "verify": "deno fmt --check && deno lint && deno check",
    "test": "deno task test:web",
    "test:web": "playwright test",
    "test:web-ui": "playwright test --ui",
    "test:web-report": "playwright show-report"
  },
  "keywords": [],
  "author": "gabriel",
  "license": "WTFPL",
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "beercss": "^4.0.21",
    "hono": "^4.12.18",
    "msedge-tts": "^2.0.5",
    "xml-escape": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.2",
    "@types/xml-escape": "^1.1.3",
    "concurrently": "^10.0.3",
    "playwright": "^1.61.0",
    "simple-git-hooks": "^2.13.1",
    "vite": "^8.0.16",
    "vite-plugin-simple-html": "^1.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "deno task verify",
    "pre-push": "deno task build --logLevel warn"
  }
}
